{
  "codeConnect": {
    "parser": "react",
    "include": [
      "codeConnect/components/Tabs/*.tsx",
      "codeConnect/components/ToggleGroup/*.tsx",
      "codeConnect/components/Pagination/*.tsx",
      "codeConnect/components/TimeStamp/*.tsx"
    ],
    "paths": {
      "src/components": ["src/components"]
    },
    "aliases": {
      "@patternfly/react-core": "."
    },
    "options": {
      "instanceSwapper": {
        "enabled": true
      },
      "development": {
        "enabled": true,
        "verbose": true
      },
      "production": {
        "enabled": false
      }
    }
  }
}